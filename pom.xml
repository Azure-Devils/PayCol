<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.centinela</groupId>
    <artifactId>api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>api</name>
    <description>Centinela - API de Ingesta de Transacciones y Motor de Scoring (Semana 2)</description>

    <properties>
        <java.version>21</java.version>
        <azure-sdk-bom.version>1.2.28</azure-sdk-bom.version>
        <!-- BOM que fija versiones compatibles de todos los starters "spring-cloud-azure-*",
             incluido el de Cosmos DB. Ver docs/decisions/001-migracion-postgresql-a-cosmosdb.md -->
        <spring-cloud-azure.version>5.20.1</spring-cloud-azure.version>
        <pdfbox.version>3.0.8</pdfbox.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.azure.spring</groupId>
                <artifactId>spring-cloud-azure-dependencies</artifactId>
                <version>${spring-cloud-azure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- PostgreSQL/JPA/Flyway se eliminaron por completo del proyecto (ver
             docs/decisions/004-eliminacion-postgresql-casos-a-cosmos.md): el almacén
             relacional NUEVO de casos de fraude introducido en la Semana 2 nunca llegó a
             desplegarse contra un servidor real y su costo (~12-13 USD/mes de Postgres
             Flexible Server) se descartó a favor de consolidar también los casos en el
             free tier permanente de Cosmos DB (ver infrastructure.adapter.outbound.casestore,
             container "cases"). El perfil "postgres-legacy" de transacciones (pre-Cosmos,
             ver docs/decisions/001-migracion-postgresql-a-cosmosdb.md) se eliminó en el
             mismo cambio, ya que dejó de tener sentido conservarlo una vez que se retira
             PostgreSQL del proyecto entero. -->

        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-queue</artifactId>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <!-- Semana 2: umbral de scoring leído directamente de Azure Key Vault en cada
             evaluación (sin caché) — ver KeyVaultScoringThresholdAdapter. Versión gestionada
             por el BOM azure-sdk-bom ya importado arriba. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-security-keyvault-secrets</artifactId>
        </dependency>

        <!-- Semana 2: control de tasa de la API de ingesta (ver RateLimitFilter). Bucket4j
             es una librería en memoria (sin Redis ni infra adicional) — encaja con la nota
             de alcance del TDD de que este proyecto no tiene un API Gateway dedicado. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- Motor de persistencia actual (Semana 1, post-migración): Azure Cosmos DB,
             API NoSQL/Core. Spring Data Cosmos nos da CosmosRepository (equivalente a
             JpaRepository, pero para documentos en vez de filas) y el soporte de
             autenticación vía Managed Identity/DefaultAzureCredential que exige el
             proyecto (nunca connection strings ni keys hardcodeadas). -->
        <dependency>
            <groupId>com.azure.spring</groupId>
            <artifactId>spring-cloud-azure-starter-data-cosmos</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
