{
  "info": {
    "_postman_id": "c3f1a2b4-8e21-4d6a-9f3c-1a2b3c4d5e6f",
    "name": "Centinela — Banco de pruebas (API real en Azure)",
    "description": "Colección funcional contra el App Service real de Centinela (chilecentral). Consolida la colección original (idempotencia/contrato/errores) con la aportada por el equipo (foldering, X-API-Key, status/receiptUploaded, rate limit, carga) y con la foto de comprobante (ReceiptPhotoDecoder). Ver docs/testing-postman.md para la guía de uso paso a paso. El caso de rate limiting en RÁFAGA no se prueba de forma confiable en Postman/Newman (peticiones en serie) — usar infra/postman/rate-limit-burst.sh para eso.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://app-centinela-api-ewhxd5fxb7g3a9fp.chilecentral-01.azurewebsites.net", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "testCustomerId", "value": "cust-postman-load", "type": "string" },
    { "key": "testMerchantId", "value": "merch-postman-load", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Flujo Feliz",
      "item": [
        {
          "name": "POST - Crear transacción válida",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueId = 'txn-' + Date.now() + '-' + Math.floor(Math.random() * 1000000);",
                  "const nowIso = new Date().toISOString();",
                  "pm.collectionVariables.set('generatedTransactionId', uniqueId);",
                  "pm.collectionVariables.set('generatedTimestamp', nowIso);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('transactionId devuelto == enviado', () => pm.expect(body.transactionId).to.eql(pm.collectionVariables.get('generatedTransactionId')));",
                  "pm.test('customerId correcto', () => pm.expect(body.customerId).to.eql(pm.collectionVariables.get('testCustomerId')));",
                  "pm.test('amountCents == 15000', () => pm.expect(body.amountCents).to.eql(15000));",
                  "pm.test('currency == USD', () => pm.expect(body.currency).to.eql('USD'));",
                  "pm.test('ingestionTimestamp presente (lo pone el servidor)', () => pm.expect(body.ingestionTimestamp).to.exist);",
                  "pm.test('status es APPROVED o UNDER_REVIEW', () => pm.expect(['APPROVED', 'UNDER_REVIEW']).to.include(body.status));",
                  "pm.test('receiptUploaded es boolean', () => pm.expect(body.receiptUploaded).to.be.a('boolean'));",
                  "pm.collectionVariables.set('createdTransactionId', body.transactionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{generatedTransactionId}}\",\n  \"customerId\": \"{{testCustomerId}}\",\n  \"amountCents\": 15000,\n  \"currency\": \"USD\",\n  \"transactionTimestamp\": \"{{generatedTimestamp}}\",\n  \"location\": {\n    \"latitude\": 6.25184,\n    \"longitude\": -75.56359,\n    \"description\": \"Medellin\"\n  },\n  \"merchantId\": \"{{testMerchantId}}\",\n  \"merchantCategory\": \"RETAIL\",\n  \"photo\": null,\n  \"photoName\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] }
          },
          "response": []
        },
        {
          "name": "GET - Obtener transacción creada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('transactionId matches createdTransactionId', () => pm.expect(body.transactionId).to.eql(pm.collectionVariables.get('createdTransactionId')));",
                  "pm.test('customerId matches testCustomerId', () => pm.expect(body.customerId).to.eql(pm.collectionVariables.get('testCustomerId')));",
                  "pm.test('amountCents == 15000 (confirma lectura real desde Cosmos)', () => pm.expect(body.amountCents).to.eql(15000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{createdTransactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{createdTransactionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "GET - Obtener recibo (receipt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type es application/pdf', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));",
                  "pm.test('el PDF no viene vacio', () => pm.expect(pm.response.responseSize).to.be.above(0));",
                  "pm.test('empieza con la cabecera magica %PDF (es un PDF real, no un error disfrazado)', () => pm.expect(pm.response.text().substring(0, 4)).to.eql('%PDF'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{createdTransactionId}}/receipt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "{{createdTransactionId}}", "receipt"]
            }
          },
          "response": []
        }
      ]
    },
