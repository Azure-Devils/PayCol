{
  "info": {
    "name": "Centinela — Banco de pruebas (API real en Azure)",
    "description": "Colección funcional contra el App Service real de Centinela (chilecentral). Cubre ingesta, idempotencia, consulta, y los caminos de error documentados en docs/API.md (400/422/404). El caso de rate limiting (burst) NO se prueba aquí de forma confiable porque Newman ejecuta las peticiones en serie y la latencia de red hacia chilecentral suele exceder la ventana de 1 segundo — ver infra/postman/rate-limit-burst.sh para esa prueba específica en paralelo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://app-centinela-api-ewhxd5fxb7g3a9fp.chilecentral-01.azurewebsites.net" },
    { "key": "idemTxId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - POST ingesta valida (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('idemTxId', 'postman-idem-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('transactionId devuelto == enviado', () => pm.expect(body.transactionId).to.eql(pm.collectionVariables.get('idemTxId')));",
              "pm.test('ingestionTimestamp presente (lo pone el servidor)', () => pm.expect(body.ingestionTimestamp).to.exist);",
              "pm.test('amountCents == 15000', () => pm.expect(body.amountCents).to.eql(15000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionId\": \"{{idemTxId}}\",\n  \"customerId\": \"cust-postman-01\",\n  \"amountCents\": 15000,\n  \"currency\": \"COP\",\n  \"transactionTimestamp\": \"{{$isoTimestamp}}\",\n  \"location\": {\n    \"latitude\": 4.710989,\n    \"longitude\": -74.072092,\n    \"description\": \"Bogota test Postman\"\n  },\n  \"merchantId\": \"merch-postman-01\",\n  \"merchantCategory\": \"5411\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions"] }
      }
    },
    {
